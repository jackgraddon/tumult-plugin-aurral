{
    "name": "tumult-plugin-aurral",
    "private": true,
    "version": "0.0.12",
    "type": "module",
    "packageManager": "pnpm@11.13.1",
    "description": "Aurral in Tumult: a music player and rich now-playing status.",
    "scripts": {
        "build": "vite build",
        "typecheck": "vue-tsc -p tsconfig.json --noEmit",
        "shim": "node scripts/gen-vue-shim.mjs",
        "release:dry": "pnpm build && node scripts/make-release-manifest.mjs"
    },
    "devDependencies": {
        "@mdi/js": "^7.4.47",
        "@vitejs/plugin-vue": "^6.0.9",
        "typescript": "^5.9.3",
        "vite": "^7.3.7",
        "vue": "^3.5.22",
        "vue-tsc": "^3.1.1"
    }
}
